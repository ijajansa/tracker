{
    "name": "Bachat",
    "short_name": "Bachat",
    "description": "Personal Expense Tracker PWA",
    "id": "/tracker",
    "start_url": "/tracker",
    "scope": "/tracker/",
    "display": "standalone",
    "background_color": "#f3f7ff",
    "theme_color": "#0f172a",
    "icons": [
        {
            "src": "/tracker/icons/icon-192.svg",
            "sizes": "192x192",
            "type": "image/svg+xml",
            "purpose": "any"
        },
        {
            "src": "/tracker/icons/icon-512.svg",
            "sizes": "512x512",
            "type": "image/svg+xml",
            "purpose": "any"
        },
        {
            "src": "/tracker/icons/icon-maskable.svg",
            "sizes": "512x512",
            "type": "image/svg+xml",
            "purpose": "maskable"
        }
    ]
}
